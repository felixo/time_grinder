# Local development only. Export these variables before running Django.
DJANGO_SECRET_KEY=local-development-only-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=time_grinder
POSTGRES_USER=time_grinder
POSTGRES_PASSWORD=time_grinder_local_only
POSTGRES_HOST=127.0.0.1
# Dedicated port avoids colliding with work-project databases.
POSTGRES_PORT=55432
